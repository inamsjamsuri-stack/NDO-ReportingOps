# ReportOps settings. Copy to .env and change every "changethis".

PROJECT_NAME="ReportOps"
# Set to "development" only on developer machines.
# FASTAPI_ENV=development

SECRET_KEY=changethis            # long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
FRONTEND_HOST=http://localhost:8000

# Self-registration (requesters ask for an account, an admin approves)
SIGNUP_ENABLED=True
SIGNUP_ALLOWED_DOMAINS=          # e.g. ioh.co.id  (empty = any domain)

# Company SMTP (leave SMTP_HOST empty to switch email off)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=True
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=reportops@example.com
EMAILS_FROM_NAME=ReportOps

# Postgres
POSTGRES_PASSWORD=changethis
# Used by tools run outside the containers:
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Podman
APP_PORT=8000
BACKUP_DIR=./backups
BACKUP_HOUR=01
